<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingFeatureDeclaration">

    <!-- Declare telephony as optional feature so Play/Lint know app can run on non-telephony devices -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Permissions required for receiving and sending SMS -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:ignore="MissingFeatureDeclaration" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:ignore="MissingFeatureDeclaration" />
    <uses-permission android:name="android.permission.READ_SMS" tools:ignore="MissingFeatureDeclaration" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsForwarder"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmsForwarder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver to handle incoming SMS -->
        <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service to keep forwarding active and show persistent notification -->
        <service android:name=".ForwardingService" android:exported="false" tools:ignore="MissingForegroundServiceType" />
    </application>

</manifest>